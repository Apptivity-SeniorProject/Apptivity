{
  "expo": {
    "name": "Apptivity",
    "slug": "apptivity",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/apptivity/apptivity_logo_monochrome.png",
    "scheme": "apptivity",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.apptivity.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Konumunuza yakin etkinlikleri gosterebilmek icin konum izni gerekiyor.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Senin Icin onerilerini iyilestirmek ve arka planda konum ozetini olusturmak icin konum izni gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Etkinlik olustururken fotograf secmek icin galeri erisimi gerekiyor."
      },
      "uiBackgroundModes": [
        "location"
      ]
    },
    "android": {
      "package": "com.apptivity.mobile",
      "usesCleartextTraffic": true,
      "notification": {
        "icon": "./assets/apptivity/apptivity_logo_monochrome.png",
        "color": "#77e349"
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/apptivity/apptivity_logo_monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/apptivity/apptivity_logo_monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/apptivity/apptivity_logo_monochrome.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_700Bold.ttf",
            "node_modules/@expo-google-fonts/inter/Inter_800ExtraBold.ttf"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
