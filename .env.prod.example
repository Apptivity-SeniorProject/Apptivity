# =============================================
# Apptivity Production / Staging Environment
# =============================================
# Bu dosyayı .env.prod olarak kopyalayıp doldurun:
#   cp .env.prod.example .env.prod
#
# Kullanım:
#   1. GHCR login:  echo $GITHUB_TOKEN | docker login ghcr.io -u <USER> --password-stdin
#   2. Başlat:      docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#   3. Güncelle:    docker compose -f docker-compose.prod.yml --env-file .env.prod pull && docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ─── Docker Image Tag (tag adı, örn: v1.0.0 veya latest) ───
IMAGE_TAG=latest


# ─── PostgreSQL ───
POSTGRES_DB=apptivity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=BURAYA_GUCLU_SIFRE_KOY

# ─── JWT ───
JWT_ISSUER=Apptivity.Api
JWT_AUDIENCE=Apptivity.Clients
JWT_SIGNING_KEY=BURAYA_MIN_32_KARAKTER_GUCLU_KEY_KOY

# ─── CORS (sunucu IP'nizi yazın) ───
CORS_ORIGIN=http://SUNUCU_IP_ADRESINIZ

# ─── Cloudinary (opsiyonel, staging'de zorunlu değil) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase Cloud Messaging ───
FCM_ENABLED=false
FCM_SERVER_KEY=
