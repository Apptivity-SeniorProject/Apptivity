{
  "ConnectionStrings": {
    "PostgreSql": "",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "Apptivity.Api",
    "Audience": "Apptivity.Clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:8081"
    ]
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "UserAvatarFolder": "apptivity/users/avatars",
    "EventBannerFolder": "apptivity/events/banners",
    "MaxFileSizeMb": 5,
    "AllowedExtensions": [".jpg", ".png", ".webp"]
  },
  "Fcm": {
    "ProjectId": "",
    "ServiceAccountJsonPath": "",
    "ServerKey": "",
    "Endpoint": "https://fcm.googleapis.com/fcm/send",
    "Enabled": false
  },
  "Database": {
    "AutoMigrateOnStartup": true
  },
  "Recommendations": {
    "RecommendedV6Enabled": true,
    "KillSwitchEnabled": false,
    "RolloutPercentage": 100
  },
  "Groq": {
    "ApiKey": "",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-20b",
    "TimeoutMs": 5000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
