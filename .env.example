# Dotnet local run (host machine)
ConnectionStrings__PostgreSql=Host=localhost;Port=5433;Database=apptivity;Username=postgres;Password=postgres
ConnectionStrings__Redis=localhost:6379

# JWT settings expected by Apptivity.Api
Jwt__Issuer=Apptivity.Api
Jwt__Audience=Apptivity.Clients
Jwt__SigningKey=CHANGE_ME_WITH_A_STRONG_SECRET_KEY_FOR_LOCAL

# --- PostgreSQL (Docker Compose) ---
POSTGRES_DB=apptivity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- JWT (Docker Compose) ---
JWT_ISSUER=Apptivity.Api
JWT_AUDIENCE=Apptivity.Clients
JWT_SIGNING_KEY=Apptivity_Docker_Secret_Key_Min32Chars_XyZ!2026

# --- Admin User ---
Admin__Email=admin@example.com
Admin__Password=BURAYA_GUCLU_ADMIN_SIFRESI_KOY

# --- Groq (LLM) ---
Groq__ApiKey=BURAYA_GROQ_API_KEY_KOY
Groq__BaseUrl=https://api.groq.com/openai/v1
Groq__Model=openai/gpt-oss-20b
Groq__TimeoutMs=120
