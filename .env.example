# =========================
# Apptivity Monorepo Env Example
# =========================


# şu anki kullandığım.env dosyası içeriği;
# Dotnet local run (host machine)
ConnectionStrings__PostgreSql=Host=localhost;Port=5433;Database=apptivity;Username=postgres;Password=postgres
ConnectionStrings__Redis=localhost:6379

# JWT settings expected by Apptivity.Api
Jwt__Issuer=Apptivity.Api
Jwt__Audience=Apptivity.Clients
Jwt__SigningKey=CHANGE_ME_WITH_A_STRONG_SECRET_KEY_FOR_LOCAL
##
#---------------------


# --- PostgreSQL ---
POSTGRES_DB=apptivity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- JWT ---
JWT_ISSUER=Apptivity.Api
JWT_AUDIENCE=Apptivity.Clients
JWT_SIGNING_KEY=CHANGE_ME_WITH_A_STRONG_SECRET

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase Cloud Messaging ---
FCM_ENABLED=false
FCM_SERVER_KEY=

# --- Optional: API runtime overrides (if needed outside compose) ---
# ASPNETCORE_ENVIRONMENT=Production
# ConnectionStrings__PostgreSql=Host=postgres;Port=5432;Database=apptivity;Username=postgres;Password=postgres
# ConnectionStrings__Redis=redis:6379
# Jwt__Issuer=Apptivity.Api
# Jwt__Audience=Apptivity.Clients
# Jwt__SigningKey=CHANGE_ME_WITH_A_STRONG_SECRET
# Cloudinary__CloudName=
# Cloudinary__ApiKey=
# Cloudinary__ApiSecret=
# Fcm__Enabled=false
# Fcm__ServerKey=
